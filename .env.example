# Use uma conta PostgreSQL com permissão somente de leitura.
PEC_DB_HOST=localhost
PEC_DB_PORT=5432
PEC_DB_NAME=esus
PEC_DB_USER=esus_leitura
PEC_DB_PASSWORD=troque-esta-senha
# PEC_DB_SSLMODE=require

# Como alternativa às variáveis acima:
# PEC_DB_DSN=host=localhost port=5432 dbname=esus user=esus_leitura password=troque-esta-senha

MCP_TRANSPORT=streamable-http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=5174
